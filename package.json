{
  "name": "construtora-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:enable-vector": "prisma db execute --file prisma/enable_vector.sql --schema prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:setup": "npm run db:enable-vector && npm run db:push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
